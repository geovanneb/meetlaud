{
  "sourceLanguage": "en",
  "strings": {
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show your upcoming meetings and name recordings after them. Your calendar stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus próximas reuniones y pon nombre a las grabaciones. Tu calendario se queda en este dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後の会議を表示し、録音に名前を付けます。カレンダーはこのデバイスから出ません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre suas próximas reuniões e dê nome às gravações. Seu calendário fica neste aparelho."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add photos of slides and whiteboards to your meetings. Photos stay on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade fotos de diapositivas y pizarras a tus reuniones. Las fotos se quedan en este dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライドやホワイトボードの写真を会議に追加できます。写真はこのデバイスから出ません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione fotos de slides e quadros às suas reuniões. As fotos ficam neste aparelho."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meetlaud records your meetings. Audio stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meetlaud graba tus reuniones. El audio se queda en este dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Meetlaudは会議を録音します。音声はこのデバイスから出ません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Meetlaud grava suas reuniões. O áudio fica neste aparelho."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add tasks from your meetings to Reminders, when you ask."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご依頼に応じて、会議のタスクをリマインダーに追加します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione tarefas das suas reuniões aos Lembretes, quando você pedir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tareas de tus reuniones a Recordatorios cuando lo pidas."
          }
        }
      }
    }
  },
  "version": "1.0"
}