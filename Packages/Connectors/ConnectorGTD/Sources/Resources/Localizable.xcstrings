    "gtd.expired_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A code works once, for five minutes. Show a new one on your computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un código funciona una vez, durante cinco minutos. Muestra uno nuevo en tu computadora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードは 1 回限り、5 分間有効です。コンピュータで新しいコードを表示してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um código funciona uma vez, por cinco minutos. Mostre um novo no computador."
          }
        }
      }
    },
