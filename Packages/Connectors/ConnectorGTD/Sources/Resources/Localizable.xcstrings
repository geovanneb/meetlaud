    "gtd.sharing_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only meetings recorded after connecting are sent, sealed for your computer, on your own network. Nothing goes through the internet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se envían las reuniones grabadas después de conectar, selladas para tu computadora, en tu propia red. Nada pasa por internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続後に録音した会議だけが、お使いのコンピュータ専用に暗号化され、自分のネットワーク上で送信されます。インターネットは経由しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só as reuniões gravadas depois de conectar são enviadas, criptografadas para o seu computador, na sua própria rede. Nada passa pela internet."
          }
        }
      }
    },
    "gtd.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get Things Done is an app on your computer that keeps your work memory for AI tools like Claude Code, Codex, and GitHub Copilot. Your meetings can feed that memory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get Things Done es una app en tu ordenador que guarda tu memoria de trabajo para herramientas de IA como Claude Code, Codex y GitHub Copilot. Tus reuniones pueden alimentar esa memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get Things Done は、Claude Code、Codex、GitHub Copilot などの AI ツールのために仕事の記憶を保存するコンピュータ用アプリです。会議の内容をその記憶に追加できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Get Things Done é um app no seu computador que guarda sua memória de trabalho para ferramentas de IA como Claude Code, Codex e GitHub Copilot. Suas reuniões podem alimentar essa memória."
          }
        }
      }
    },
