    "gtd.unreachable_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that both devices are on the same network, and that Local Network is allowed for Meetlaud in iOS Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que ambos dispositivos estén en la misma red y que Red local esté permitida para Meetlaud en Ajustes de iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方のデバイスが同じネットワークにあること、および iOS の設定で Meetlaud のローカルネットワークが許可されていることを確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira se os dois aparelhos estão na mesma rede e se Rede Local está permitida para o Meetlaud nos Ajustes do iOS."
          }
        }
      }
    },
    "gtd.unreachable_title" : {
