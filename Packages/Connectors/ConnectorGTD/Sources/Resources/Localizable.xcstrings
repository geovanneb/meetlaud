    "gtd.not_a_code_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your computer, open Get Things Done, Settings, Devices, then Connect an iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu computadora, abre Get Things Done, Configuración, Dispositivos y luego Conectar un iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータで Get Things Done を開き、「設定」「デバイス」「iPhone を接続」の順に進みます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No computador, abra o Get Things Done, Ajustes, Dispositivos e depois Conectar um iPhone."
          }
        }
      }
    },
    "gtd.not_a_code_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That is not a pairing code"
