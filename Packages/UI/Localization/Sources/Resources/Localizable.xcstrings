    "system.help_ask_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answers use only your recordings, and each one links to the moment it came from. Check the source for anything important: AI can be wrong."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答は録音のみを使い、それぞれ該当する箇所にリンクします。重要な内容は出典を確認してください。AIは間違えることがあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas usam só suas gravações, e cada uma aponta para o momento de origem. Confira a fonte do que for importante: a IA pode errar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas usan solo tus grabaciones, y cada una enlaza al momento de origen. Comprueba la fuente de lo importante: la IA puede equivocarse."
          }
        }
      }
    },
