    "people.consent_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A voice print identifies a person, and laws in many places protect it. Only save %@'s voice if they agree. It stays on this device, and you can delete it at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una huella de voz identifica a una persona, y las leyes de muchos lugares la protegen. Guarda la voz de %@ solo si está de acuerdo. Se queda en este dispositivo y puedes eliminarla cuando quieras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声紋は個人を特定する情報で、多くの地域で法律により保護されています。%@さんの同意がある場合のみ保存してください。声紋はこのデバイスに残り、いつでも削除できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um voice print identifica uma pessoa, e leis de muitos lugares o protegem. Só salve a voz de %@ com a concordância dessa pessoa. Ela fica neste aparelho, e você pode apagar quando quiser."
          }
        }
      }
    },
