        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリのカレンダーへのアクセスはオフです。「設定」アプリで許可できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao calendário está desativado para este app. Você pode permitir no app Ajustes."
          }
