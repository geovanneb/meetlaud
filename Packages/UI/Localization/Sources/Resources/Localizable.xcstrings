    "models.network_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app connects only to download the models you ask for and, if you use a connector such as Get Things Done, to the computer you paired on your local network. Your recordings never go to the internet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app solo se conecta para descargar los modelos que pidas y, si usas un conector como Get Things Done, al ordenador que vinculaste en tu red local. Tus grabaciones nunca van a internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが接続するのは、要求したモデルをダウンロードするときと、Get Things Done などのコネクタを使う場合に、ローカルネットワーク上でペアリングしたコンピュータへ送るときだけです。録音がインターネットに送られることはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app só se conecta para baixar os modelos que você pedir e, se você usa um conector como o Get Things Done, ao computador que você pareou na sua rede local. Suas gravações nunca vão para a internet."
          }
        }
      }
    },
