    "system.help_record_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap record and leave the app if you like. Recording continues on the Lock Screen, and survives calls and crashes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音をタップしたら、アプリを離れてもかまいません。ロック画面でも録音は続き、電話やクラッシュがあっても失われません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em gravar e saia do app se quiser. A gravação continua na Tela Bloqueada e sobrevive a ligações e travamentos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca grabar y sal de la app si quieres. La grabación sigue en la pantalla bloqueada y resiste llamadas y fallos."
          }
        }
      }
    },
    "system.help_record_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
