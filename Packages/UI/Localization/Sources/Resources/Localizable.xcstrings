    "system.promise_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing you record, type, or ask. Everything runs on this device. There are no accounts and no analytics. The only connections are the AI model downloads you start, and Network activity lists every one. iOS itself may fetch its own language models."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音、入力、質問の内容は一切送信されません。すべてこのデバイス上で実行されます。アカウントも分析もありません。通信はあなたが開始したAIモデルのダウンロードのみで、ネットワークアクティビティにすべて記録されます。iOS自体が言語モデルを取得する場合があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada do que você grava, digita ou pergunta. Tudo roda neste aparelho. Não há contas nem análises. As únicas conexões são os downloads de modelos de IA que você inicia, e a Atividade de rede lista cada um. O próprio iOS pode baixar seus modelos de linguagem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de lo que grabas, escribes o preguntas. Todo funciona en este dispositivo. No hay cuentas ni analíticas. Las únicas conexiones son las descargas de modelos de IA que inicias, y Actividad de red las muestra todas. iOS puede descargar sus propios modelos de lenguaje."
          }
        }
      }
    },
    "system.promise_title" : {
