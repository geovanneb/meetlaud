    "system.help_models_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripts, summaries, and answers come from models on your device. Download them once from AI models, and they work with no connection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字起こし、要約、回答はデバイス上のモデルで作られます。AIモデルから一度ダウンロードすれば、通信なしで動作します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcrições, resumos e respostas vêm de modelos no seu aparelho. Baixe uma vez em Modelos de IA e eles funcionam sem conexão."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las transcripciones, resúmenes y respuestas vienen de modelos en tu dispositivo. Descárgalos una vez en Modelos de IA y funcionan sin conexión."
          }
        }
      }
    },
    "system.help_models_title" : {
      "extractionState" : "manual",
      "localizations" : {
