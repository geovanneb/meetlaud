      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. When on, your recordings go into your iPhone's backup, which may be iCloud. AI models are never included."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期設定はオフです。オンにすると、録音はiPhoneのバックアップ（iCloudの場合があります）に含まれます。AIモデルは含まれません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado por padrão. Ligado, suas gravações entram no backup do iPhone, que pode ser o iCloud. Os modelos de IA nunca entram."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado por defecto. Si lo activas, tus grabaciones entran en la copia del iPhone, que puede ser iCloud. Los modelos de IA nunca se incluyen."
