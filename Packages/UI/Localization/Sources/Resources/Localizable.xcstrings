    "calendars.denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar access is off for this app. You can allow it in the Settings app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso al calendario está desactivado para esta app. Puedes permitirlo en la app Ajustes."
