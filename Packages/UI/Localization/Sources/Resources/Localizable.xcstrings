    "calendars.revoke" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turning this off stops the app from reading your calendars. To take back access completely, turn it off in the Settings app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desactivarlo, la app deja de leer tus calendarios. Para retirar el acceso por completo, desactívalo en la app Ajustes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、アプリはカレンダーを読み取りません。アクセスを完全に取り消すには、「設定」アプリでオフにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar isto faz o app parar de ler seus calendários. Para retirar o acesso por completo, desative no app Ajustes."
          }
        }
      }
    },
