    "calendars.add_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the account in the Settings app, under Apps > Calendar > Calendar Accounts, for example Microsoft Exchange or Outlook.com. In the Outlook app, you can also turn on syncing its calendars to this device, if your company allows it. The calendar then appears here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la cuenta en la app Ajustes, en Apps > Calendario > Cuentas de calendario, por ejemplo Microsoft Exchange u Outlook.com. En la app Outlook también puedes activar la sincronización de sus calendarios con este dispositivo, si tu empresa lo permite. El calendario aparecerá aquí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」アプリの「アプリ」>「カレンダー」>「カレンダーアカウント」で、Microsoft Exchange や Outlook.com などのアカウントを追加します。会社が許可していれば、Outlook アプリでカレンダーをこのデバイスに同期することもできます。追加したカレンダーはここに表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione a conta no app Ajustes, em Apps > Calendário > Contas de Calendário, por exemplo Microsoft Exchange ou Outlook.com. No app Outlook, você também pode ativar a sincronização dos calendários com este aparelho, se sua empresa permitir. O calendário então aparece aqui."
          }
        }
      }
    },
    "calendars.add_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
