          }
        }
      }
    },
    "system.help_move_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Storage & backup, export your library to a password-protected file, move it to the new phone, and import it there."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ストレージとバックアップ」でライブラリをパスワード付きファイルに書き出し、新しいiPhoneに移して読み込みます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em Armazenamento e backup, exporte a biblioteca para um arquivo com senha, leve ao novo celular e importe lá."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Almacenamiento y copia de seguridad, exporta tu biblioteca a un archivo con contraseña, llévalo al nuevo teléfono e impórtalo allí."
          }
        }
      }
    },
