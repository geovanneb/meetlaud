          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabación"
          }
        }
      }
    },
    "system.help_shortcuts_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose “Record or stop” in iOS Settings for the Action Button, or add the control to Control Center. Siri can record, stop, mark a moment, and open your last meeting."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSの設定でアクションボタンに「録音または停止」を選ぶか、コントロールセンターに追加してください。Siriで録音、停止、マーク、最後の会議を開くことができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha “Gravar ou parar” nos Ajustes do iOS para o Botão de Ação, ou adicione o controle à Central de Controle. A Siri pode gravar, parar, marcar um momento e abrir sua última reunião."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige “Grabar o detener” en Ajustes de iOS para el botón de Acción, o añade el control al centro de control. Siri puede grabar, detener, marcar un momento y abrir tu última reunión."
          }
        }
      }
    },
