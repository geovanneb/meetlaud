#!/bin/sh
# Starts a headless Android emulator and waits until it has booted, for CI (D-086).
#
# Usage: Tools/android-emulator [api level, default 34]
#
# Needs ANDROID_HOME. Installs the system image the first time. An x86_64 image from Android 11 runs the app's ARM64
# code by translation, and KVM makes it fast enough (the workflow enables it). Animations are turned off, so UI tests
# never wait for them.
set -eu
api=${1:-34}
image="system-images;android-$api;google_apis;x86_64"
sdk="$ANDROID_HOME/cmdline-tools/latest/bin"
yes | "$sdk/sdkmanager" "emulator" "platform-tools" "$image" > /dev/null
echo no | "$sdk/avdmanager" create avd --force -n ci -k "$image" -d pixel_6 > /dev/null
"$ANDROID_HOME/emulator/emulator" -avd ci -no-window -no-audio -no-boot-anim -no-snapshot \
    -gpu swiftshader_indirect -accel on -memory 4096 > "${RUNNER_TEMP:-/tmp}/emulator.log" 2>&1 &
adb="$ANDROID_HOME/platform-tools/adb"
"$adb" wait-for-device
seconds=0
until [ "$("$adb" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = "1" ]; do
    seconds=$((seconds + 5))
    if [ "$seconds" -gt 600 ]; then
        echo "android-emulator: no boot after 10 minutes" >&2
        tail -50 "${RUNNER_TEMP:-/tmp}/emulator.log" >&2
        exit 1
    fi
    sleep 5
done
for setting in window_animation_scale transition_animation_scale animator_duration_scale; do
    "$adb" shell settings put global "$setting" 0
done
"$adb" shell input keyevent KEYCODE_WAKEUP
echo "android-emulator: booted in about $seconds seconds"
