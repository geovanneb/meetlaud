#!/usr/bin/env python3
"""Writes Android's icons: one vector drawable per SF Symbol the iOS app uses (D-084).

Usage: android-icons <android res dir>

SF Symbols may only be used on Apple platforms, so Android draws the closest Lucide icon (ISC license, pinned below)
instead. Each drawable is named after the symbol it stands for, `sf_<symbol with dots as underscores>`, so a feature
ports from Swift by name: Image(systemName: "folder") becomes SfIcon("folder").

The output is committed. This script is only for adding or changing an icon, and it is the one tool that downloads,
from the pinned package on jsDelivr. Run it again after editing SYMBOLS, and record new icons nowhere else.
"""
import math
import re
import sys
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path

LUCIDE = "https://cdn.jsdelivr.net/npm/lucide-static@0.460.0/icons/{}.svg"
# SF Symbols at the regular weight are a little lighter than Lucide's default stroke of 2.
STROKE = 1.75

# SF Symbol -> (Lucide icon, fill). "fill" fills every closed shape, for the .fill variants.
SYMBOLS = {
