#!/usr/bin/env python3
"""Builds Android's text from the iOS String Catalogs, so both apps always show the same words (D-084).

Usage: android-strings <repo root> <res output dir> <kotlin output dir>

Writes, from the catalogs listed in CATALOGS:
  <res>/values[-ja|-pt-rBR|-es]/strings.xml   every key, with dots turned into underscores
  <kotlin>/com/meetlaud/app/localization/L10n.kt
      the same accessors as ios/Packages/UI/Localization/Sources/L10n*.swift, name for name:
      L10n.Home.upcoming, L10n.Recorder.defaultTitle(date), ...

Accessors written by hand in Swift (a switch, or a choice between two keys) are listed in HANDWRITTEN and live in
android/app/src/main/kotlin/com/meetlaud/app/localization/L10nExtras.kt. Anything else the parser cannot read fails
the build, so a new Swift accessor can never silently go missing on Android.
"""
import json
import re
import sys
from pathlib import Path
from xml.sax.saxutils import escape

CATALOGS = [
    "ios/Packages/UI/Localization/Sources/Resources/Localizable.xcstrings",
    "ios/Packages/Connectors/ConnectorGTD/Sources/Resources/Localizable.xcstrings",
    "ios/App/Resources/InfoPlist.xcstrings",
    # The recording controls outside the app: Live Activity buttons on iOS, notification actions on Android.
    "ios/App/Resources/Localizable.xcstrings",
    # Text only Android shows, such as the Back label that iOS draws itself. Same format, same four languages.
    "android/l10n/Platform.xcstrings",
]
L10N_SOURCES = "ios/Packages/UI/Localization/Sources"
LANGUAGES = {"en": "values", "ja": "values-ja", "pt-BR": "values-pt-rBR", "es": "values-es"}
HANDWRITTEN = {
    "Summary.templateName", "Summary.sectionTitle", "Templates.category",
    "Skills.builtInName", "Skills.builtInSummary", "Library.itemCount",
}
KOTLIN_TYPES = {"String": "String", "Int": "Int", "Double": "Double", "Int64": "Long"}


def resource_name(key):
    name = re.sub(r"[^A-Za-z0-9_]", "_", key)
    return name if name[0].isalpha() else "k_" + name


def android_format(value):
    """Turns Apple format specifiers into Java ones. %@ is a string, %lld an integer."""
    value = re.sub(r"%(\d+\$)?@", lambda m: "%" + (m.group(1) or "") + "s", value)
    return re.sub(r"%(\d+\$)?l{0,2}d", lambda m: "%" + (m.group(1) or "") + "d", value)


def android_escape(value):
    value = escape(value).replace("\\", "\\\\").replace("'", "\\'").replace('"', '\\"').replace("\n", "\\n")
    if value[:1] in ("@", "?"):
        value = "\\" + value
    return value


def write_resources(root, res_dir):
    strings = {}
    for catalog in CATALOGS:
        data = json.loads((root / catalog).read_text())["strings"]
        for key, entry in data.items():
            if key in strings:
                raise SystemExit(f"android-strings: key '{key}' is in two catalogs")
            strings[key] = entry.get("localizations", {})
    for language, folder in LANGUAGES.items():
        lines = ['<?xml version="1.0" encoding="utf-8"?>', "<!-- Generated by Tools/android-strings. Edit the .xcstrings. -->", "<resources>"]
        if language == "en":
            lines.append('    <string name="app_name" translatable="false">Meetlaud</string>')
        for key in sorted(strings):
            unit = strings[key].get(language, strings[key].get("en", {})).get("stringUnit")
            if unit is None:
                if language == "en":
                    raise SystemExit(f"android-strings: '{key}' has no English text")
                continue
            value = android_escape(android_format(unit["value"]))
            lines.append(f'    <string name="{resource_name(key)}" formatted="false">{value}</string>')
        lines.append("</resources>")
        out = res_dir / folder / "strings.xml"
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text("\n".join(lines) + "\n")
    return strings


VAR = re.compile(r'static var (\w+): String \{ (?:L10n\.)?text\("([^"]+)"\) \}')
FUNC = re.compile(r"static func (\w+)\(([^)]*)\) -> String \{")
FORMAT = re.compile(r'^String\(format: (?:L10n\.)?text\("([^"]+)"\),\s*(.+)\)$')
OPEN = re.compile(r"(?:public )?(?:extension L10n(?:\.(\w+))?|enum (\w+)) \{")


def parse_swift(root):
    """Returns {object name: [kotlin member lines]} from the Swift accessors."""
    objects = {}
    for path in sorted((root / L10N_SOURCES).glob("L10n*.swift")):
        stack = []
        lines = path.read_text().splitlines()
        index = 0
        while index < len(lines):
            line = lines[index].strip()
            index += 1
            if line.startswith("//") or not line:
                continue
            opened = OPEN.search(line)
            if opened and line.endswith("{") and "static" not in line:
                stack.append(opened.group(1) or opened.group(2) or "L10n")
                continue
            if line == "}":
                if stack:
                    stack.pop()
                continue
            current = next((name for name in reversed(stack) if name != "L10n"), None)
            if (match := VAR.search(line)) and current:
                objects.setdefault(current, []).append(
                    f'        val {match.group(1)}: String get() = text("{match.group(2)}")')
                continue
            if (match := FUNC.search(line)) and current:
                name, params = match.group(1), match.group(2)
                # A function body runs to its closing brace at the same depth.
                body = []
                depth = 1
                while index < len(lines) and depth:
                    text = lines[index].strip()
                    index += 1
                    depth += text.count("{") - text.count("}")
                    if depth:
                        body.append(text)
                if f"{current}.{name}" in HANDWRITTEN:
                    continue
                formatted = FORMAT.match(" ".join(body)) if len(body) == 1 else None
                if not formatted:
                    raise SystemExit(f"android-strings: cannot read L10n.{current}.{name} in {path.name}. "
                                     "Write it in L10nExtras.kt and add it to HANDWRITTEN")
                arguments = []
                for param in filter(None, (p.strip() for p in params.split(","))):
                    label, swift_type = param.split(":")
                    arg_name = label.split()[-1]
                    arguments.append((arg_name, KOTLIN_TYPES[swift_type.strip()]))
                signature = ", ".join(f"{n}: {t}" for n, t in arguments)
                values = ", ".join(n for n, _ in arguments)
                objects.setdefault(current, []).append(
                    f'        fun {name}({signature}): String = format(text("{formatted.group(1)}"), {values})')
                continue
            if "static func text(" in line:
                # The lookup itself, which Kotlin implements in L10nExtras.kt.
                index += 2
                continue
            if "static" in line:
                raise SystemExit(f"android-strings: cannot read '{line}' in {path.name}")
    return objects


def write_kotlin(objects, strings, kotlin_dir):
    out = kotlin_dir / "com/meetlaud/app/localization/L10n.kt"
    out.parent.mkdir(parents=True, exist_ok=True)
    body = [
        "// Generated by Tools/android-strings from ios/Packages/UI/Localization/Sources. Do not edit.",
        "package com.meetlaud.app.localization",
        "",
        "import com.meetlaud.app.R",
        "",
        "/** All user-facing text, with the same names as the iOS app's L10n. Keys live in the iOS String Catalogs. */",
        "object L10n {",
    ]
    for name in sorted(objects):
        body.append(f"    object {name} {{")
        body.extend(objects[name])
        body.append("    }")
        body.append("")
    body.append("    internal val ids: Map<String, Int> = mapOf(")
    for key in sorted(strings):
        body.append(f'        "{key}" to R.string.{resource_name(key)},')
    body.append("    )")
    body.append("}")
    out.write_text("\n".join(body) + "\n")


def main(root, res_dir, kotlin_dir):
    strings = write_resources(root, res_dir)
    write_kotlin(parse_swift(root), strings, kotlin_dir)


if __name__ == "__main__":
    if len(sys.argv) != 4:
        raise SystemExit(__doc__)
    main(Path(sys.argv[1]).resolve(), Path(sys.argv[2]).resolve(), Path(sys.argv[3]).resolve())
