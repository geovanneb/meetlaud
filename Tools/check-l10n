#!/usr/bin/env python3
"""Fails on missing translations and on UI text outside the String Catalog.

Usage: check-l10n [repo-root]
"""
import json
import re
import sys
from pathlib import Path

LANGUAGES = ["en", "ja", "pt-BR", "es"]
CATALOG = "Packages/UI/Localization/Sources/Resources/Localizable.xcstrings"
INFO_CATALOGS = [
    "App/Resources/InfoPlist.xcstrings",
    "App/Resources/Localizable.xcstrings",
    "App/Resources/AppShortcuts.xcstrings",
]
KEYS_DIR = "Packages/UI/Localization/Sources"
LITERAL = re.compile(
    r'(?<![\w.])(?:Text|Label|Button|Toggle|TextField|SecureField|Section|Menu|Picker|Link|'
    r'ContentUnavailableView|Tab|NavigationLink)\(\s*"(?!")'
    r'|\.(?:navigationTitle|accessibilityLabel|accessibilityHint|accessibilityValue|alert|'
    r'confirmationDialog|searchable|tabItem)\(\s*"'
)
PLACEHOLDER = re.compile(r"%(?:\d+\$)?(?:lld|ld|d|@|f|\.\d+f)")


def strip_previews(code):
    """Previews are development-only, so their sample text is not UI text."""
    index = code.find("#Preview")
    return code if index < 0 else code[:index]


def main(root):
    errors = []
    catalog = json.loads((root / CATALOG).read_text())["strings"]
    info = {}
    for name in INFO_CATALOGS:
        info_file = root / name
        if info_file.exists():
            info.update(json.loads(info_file.read_text())["strings"])

    for key, entry in {**catalog, **info}.items():
        localizations = entry.get("localizations", {})
        source = localizations.get("en", {}).get("stringUnit", {}).get("value", "")
        for language in LANGUAGES:
            unit = localizations.get(language, {}).get("stringUnit", {})
            if unit.get("state") != "translated" or not unit.get("value", "").strip():
                errors.append(f"{CATALOG}: '{key}' has no translation for {language}")
            elif sorted(PLACEHOLDER.findall(unit["value"])) != sorted(PLACEHOLDER.findall(source)):
                errors.append(f"{CATALOG}: '{key}' has different placeholders in {language}")

    used = set()
    for file in sorted((root / KEYS_DIR).glob("*.swift")):
        used |= set(re.findall(r'text\("([^"]+)"', file.read_text()))
    for key in sorted(used - set(catalog)):
        errors.append(f"{KEYS_DIR}: '{key}' is not in the String Catalog")
    for key in sorted(set(catalog) - used):
        errors.append(f"{CATALOG}: '{key}' is not used")

    for base in ("App", "Extensions", "Packages/Features", "Packages/UI"):
        for file in (root / base).rglob("*.swift"):
            if "Tests" in file.parts or file.name == "Package.swift":
                continue
            code = strip_previews(file.read_text())
            for number, line in enumerate(code.splitlines(), 1):
                if LITERAL.search(line.split("//", 1)[0]):
                    errors.append(f"{file.relative_to(root)}:{number}: UI text outside the String Catalog")

    for error in errors:
        print(f"error: {error}")
    print(f"check-l10n: {len(errors)} problem(s)")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main(Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()))
