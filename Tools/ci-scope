#!/usr/bin/env python3
"""Decides how much of CI a pull request needs, from the files it changes.

Usage: git diff --name-only BASE HEAD | ci-scope

Prints three lines for $GITHUB_OUTPUT:
  ios=true|false       false when nothing that reaches the iOS app changed, so the macOS jobs can be skipped
  android=true|false   false when nothing that reaches the Android app changed, so the Android jobs can be skipped
  full=false           a pull request never runs every UI test: that is about 30 minutes. main and the nightly run do (D-082)
"""
import re
import sys

# Files that never reach either app or the tests.
DOCS = re.compile(
    r"""(
        .*\.md
      | docs/.*
      | LICENSE
      | \.github/ISSUE_TEMPLATE/.*
      | \.github/pull_request_template\.md
      | \.github/CODEOWNERS
      | \.github/release\.yml
      | \.github/dependabot\.yml
    )$""",
    re.VERBOSE,
)

# Files inside ios/ that the Android app depends on (D-084): text it is generated from, and the Domain its parity
# test checks it against.
SHARED = re.compile(r"ios/(.*\.xcstrings|.*/models\.json|Packages/Core/Domain/Sources/.*|Packages/UI/Localization/Sources/.*)$")


def scope(files):
    """Returns (ios, android, full)."""
    files = [name.strip() for name in files if name.strip()]
    if not files:
        # An empty diff means we could not tell. Run everything rather than skip it.
        return True, True, False
    ios = android = False
    for name in files:
        if DOCS.match(name):
            continue
        if SHARED.match(name):
            ios = android = True
        elif name.startswith("ios/"):
            ios = True
        elif name.startswith("android/"):
            android = True
        else:
            # Root tools, workflows, and anything new: both apps may depend on it.
            ios = android = True
    return ios, android, False


def main():
    ios, android, full = scope(sys.stdin.read().splitlines())
    print(f"ios={str(ios).lower()}")
    print(f"android={str(android).lower()}")
    print(f"full={str(full).lower()}")


if __name__ == "__main__":
    main()
