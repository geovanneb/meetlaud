#!/usr/bin/env python3
"""Decides how much of CI a pull request needs, from the files it changes.

Usage: git diff --name-only BASE HEAD | ci-scope

Prints two lines for $GITHUB_OUTPUT:
  ios=true|false   false when every file is documentation, so the macOS jobs can be skipped
  full=false       a pull request never runs every UI test: that is about 30 minutes. main and the nightly run do (D-082)
"""
import re
import sys

# Files that never reach the app or the tests.
DOCS = re.compile(
    r"""(
        .*\.md
      | docs/.*
      | LICENSE
      | \.github/ISSUE_TEMPLATE/.*
      | \.github/pull_request_template\.md
      | \.github/CODEOWNERS
      | \.github/release\.yml
      | \.github/dependabot\.yml
    )$""",
    re.VERBOSE,
)


def scope(files):
    files = [name.strip() for name in files if name.strip()]
    if not files:
        # An empty diff means we could not tell. Run the macOS jobs rather than skip them.
        return True, False
    return any(not DOCS.match(name) for name in files), False


def main():
    ios, full = scope(sys.stdin.read().splitlines())
    print(f"ios={str(ios).lower()}")
    print(f"full={str(full).lower()}")


if __name__ == "__main__":
    main()
