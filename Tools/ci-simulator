#!/usr/bin/env python3
"""Picks an iPhone simulator that exists on this machine, and prints its xcodebuild destination.

Usage: ci-simulator [preferred name]   (default: iPhone 17 Pro)

GitHub's macOS images do not always carry the same simulators. Asking for one by name failed a whole job when it was
missing, so CI asks this script instead: the preferred name on the newest iOS, or else the newest iPhone there is.
"""
import json
import re
import subprocess
import sys


def runtime_version(identifier):
    # com.apple.CoreSimulator.SimRuntime.iOS-26-5 -> (26, 5)
    match = re.search(r"iOS-([\d-]+)$", identifier)
    return tuple(int(part) for part in match.group(1).split("-")) if match else ()


def pick(devices_by_runtime, preferred):
    runtimes = sorted((key for key in devices_by_runtime if runtime_version(key)), key=runtime_version, reverse=True)
    iphones = [
        device
        for runtime in runtimes
        for device in devices_by_runtime[runtime]
        if device.get("isAvailable", True) and device["name"].startswith("iPhone")
    ]
    for device in iphones:
        if device["name"] == preferred:
            return device
    return iphones[0] if iphones else None


def main():
    preferred = sys.argv[1] if len(sys.argv) > 1 else "iPhone 17 Pro"
    listing = subprocess.run(
        ["xcrun", "simctl", "list", "devices", "available", "-j"], check=True, capture_output=True, text=True
    ).stdout
    device = pick(json.loads(listing)["devices"], preferred)
    if device is None:
        sys.exit("No iPhone simulator is available")
    print(f"Using {device['name']} ({device['udid']})", file=sys.stderr)
    print(f"platform=iOS Simulator,id={device['udid']}")


if __name__ == "__main__":
    main()
