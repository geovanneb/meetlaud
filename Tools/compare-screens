#!/usr/bin/env python3
"""Puts an iOS and an Android screenshot of the same screen side by side, in points, for the parity review (D-084).

Usage: compare-screens <ios.png> <android.png> <out.png> [--android-density 2.75] [--android-top 34] [--ios-top 62]

Both pictures are cut at the top of the safe area (below the status bar), scaled to points (iOS) and dp (Android),
which are the same unit for layout, and drawn next to each other on a shared grid every 20 points. A third column
lays one over the other at half opacity: anything that moved shows twice.
"""
import argparse
import sys
from PIL import Image, ImageDraw

SCALE = 2  # output pixels per point


def prepare(path, density, top, width_points=None):
    image = Image.open(path).convert("RGB")
    cut = image.crop((0, round(top * density), image.width, image.height))
    width = round(cut.width / density * SCALE)
    height = round(cut.height / density * SCALE)
    return cut.resize((width, height), Image.LANCZOS)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("ios")
    parser.add_argument("android")
    parser.add_argument("out")
    parser.add_argument("--ios-density", type=float, default=3.0)
    parser.add_argument("--ios-top", type=float, default=62)
    parser.add_argument("--android-density", type=float, default=2.75)
    parser.add_argument("--android-top", type=float, default=33.8)
    parser.add_argument("--height", type=float, default=700, help="points to show from the safe area down")
    args = parser.parse_args()

    ios = prepare(args.ios, args.ios_density, args.ios_top)
    android = prepare(args.android, args.android_density, args.android_top)
    height = round(args.height * SCALE)
    ios = ios.crop((0, 0, ios.width, min(height, ios.height)))
    android = android.crop((0, 0, android.width, min(height, android.height)))

    gap = 12 * SCALE
    overlay_width = max(ios.width, android.width)
    canvas = Image.new("RGB", (ios.width + android.width + overlay_width + gap * 2, height), "white")
    canvas.paste(ios, (0, 0))
    canvas.paste(android, (ios.width + gap, 0))
    base = Image.new("RGB", (overlay_width, height), "white")
    base.paste(ios, (0, 0))
    top = Image.new("RGB", (overlay_width, height), "white")
    top.paste(android, (0, 0))
    canvas.paste(Image.blend(base, top, 0.5), (ios.width + android.width + gap * 2, 0))

    draw = ImageDraw.Draw(canvas)
    for y in range(0, height, 20 * SCALE):
        color = (255, 0, 0) if y % (100 * SCALE) == 0 else (255, 180, 180)
        draw.line([(0, y), (canvas.width, y)], fill=color, width=1)
        draw.text((2, y + 1), str(y // SCALE), fill=(200, 0, 0))
    canvas.save(args.out)
    print(f"compare-screens: {args.out}")


if __name__ == "__main__":
    sys.exit(main())
