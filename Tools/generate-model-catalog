def apple_embedding():
    return {
        "id": "apple-embedding",
        "version": "system",
        "displayName": "Apple Language Search",
        "roles": ["search"],
        "runtime": "appleLanguage",
        "license": "Apple",
        "sourceHost": "apple.com",
        "repo": "",
        "files": [],
        "languages": WHISPER_LANGUAGES,
