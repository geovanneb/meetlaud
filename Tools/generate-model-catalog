#!/usr/bin/env python3
"""Builds the model catalog from pinned Hugging Face revisions.

Every file gets a real size and SHA-256, so the app can verify what it downloads, and the catalog never
needs a server of ours. Quality values are provisional until SP-2 reports. See docs/model-management.md.

Usage: generate-model-catalog
"""
import hashlib
import json
import sys
import urllib.request
from pathlib import Path

OUTPUT = Path(__file__).resolve().parent.parent / "Packages/Infrastructure/ModelDelivery/Sources/Resources/models.json"
API = "https://huggingface.co/api/models"
WHISPER_LANGUAGES = ["en", "ja", "pt", "es"]


def fetch_json(url):
    with urllib.request.urlopen(url, timeout=60) as response:
        return json.load(response)


def revision_of(repo):
    return fetch_json(f"{API}/{repo}")["sha"]


def resolve_url(repo, revision, path):
    return f"https://huggingface.co/{repo}/resolve/{revision}/{path}"


def tree(repo, revision, folder):
    url = f"{API}/{repo}/tree/{revision}/{folder}?recursive=true"
    return [item for item in fetch_json(url) if item["type"] == "file"]


def sha256_of(url):
    digest = hashlib.sha256()
    with urllib.request.urlopen(url, timeout=120) as response:
        while chunk := response.read(1 << 20):
            digest.update(chunk)
    return digest.hexdigest()


def describe(repo, revision, item, destination):
    url = resolve_url(repo, revision, item["path"])
    # LFS files publish their hash. Small files in git do not, so those are hashed here.
    digest = item["lfs"]["oid"] if "lfs" in item else sha256_of(url)
    return {"path": destination, "url": url, "size": item["size"], "sha256": digest}


def whisper(model_id, name, folder, tokenizer_repo, memory_mb, quality):
    repo = "argmaxinc/whisperkit-coreml"
    revision = revision_of(repo)
    print(f"{model_id}: {revision[:10]}", file=sys.stderr)
    files = [
        describe(repo, revision, item, "model/" + item["path"].split("/", 1)[1])
        for item in tree(repo, revision, folder)
    ]
    # Without these, WhisperKit silently downloads them from the Hub, outside ModelDelivery.
    token_revision = revision_of(tokenizer_repo)
    for item in fetch_json(f"{API}/{tokenizer_repo}/tree/{token_revision}"):
        if item["type"] == "file" and item["path"] in ("tokenizer.json", "tokenizer_config.json"):
            files.append(describe(tokenizer_repo, token_revision, item, item["path"]))
    return {
        "id": model_id,
        "version": revision[:10],
        "displayName": name,
        "roles": ["transcription"],
        "runtime": "whisperKit",
        "license": "MIT",
        "sourceHost": "huggingface.co",
        "repo": repo,
        "files": files,
        "languages": WHISPER_LANGUAGES,
        "minMemoryMB": memory_mb,
        "backgroundCapable": True,
        "quality": quality,
        "qualityIsProvisional": True,
        "reference": [],
    }


def community_one():
    """Speaker separation and voice print share this model. Only the cleared artifacts, see SP-6."""
    repo = "FluidInference/speaker-diarization-coreml"
    # The revision FluidAudio is built for. It refuses any other, so this moves together with the package.
    revision = "df2625ac79a7ac6b65ad868fee6d80f320da4232"
    allowed = (
        "Segmentation.mlmodelc/", "FBank.mlmodelc/", "Embedding.mlmodelc/", "PLDA.mlmodelc/",
        "PldaRho.mlmodelc/",
    )
    single = ("plda-parameters.json", "xvector-transform.json")
    items = fetch_json(f"{API}/{repo}/tree/{revision}?recursive=true")
    files = [
        # FluidAudio looks for its files inside this folder.
        describe(repo, revision, item, "speaker-diarization/" + item["path"])
        for item in items
        if item["type"] == "file" and (item["path"].startswith(allowed) or item["path"] in single)
    ]
    print(f"community-1: {revision[:10]}", file=sys.stderr)
    return {
        "id": "pyannote-community-1",
        "version": revision[:10],
        "displayName": "Pyannote Community-1",
        "roles": ["speakerSeparation", "voicePrint"],
        "runtime": "fluidAudio",
        "license": "CC-BY-4.0",
        "sourceHost": "huggingface.co",
        "repo": repo,
        "files": files,
        "languages": [],
        "minMemoryMB": 400,
        "backgroundCapable": True,
        "quality": {},
        "qualityIsProvisional": True,
        "reference": [],
    }


def qwen_2b():
    """Text only: the repository also holds 663 MB of vision weights that this app never uses."""
    repo = "mlx-community/Qwen3.5-2B-OptiQ-4bit"
    revision = revision_of(repo)
    wanted = (
        "config.json", "generation_config.json", "model.safetensors", "model.safetensors.index.json",
        "tokenizer.json", "tokenizer_config.json", "chat_template.jinja",
    )
    files = [
        describe(repo, revision, item, item["path"])
        for item in fetch_json(f"{API}/{repo}/tree/{revision}")
        if item["type"] == "file" and item["path"] in wanted
    ]
    print(f"qwen-2b: {revision[:10]}", file=sys.stderr)
    return {
        "id": "qwen35-2b",
        "version": revision[:10],
        "displayName": "Qwen 3.5 2B",
        "roles": ["chat"],
        "runtime": "mlx",
        "license": "Apache-2.0",
        "sourceHost": "huggingface.co",
        "repo": repo,
        "files": files,
        "languages": WHISPER_LANGUAGES,
        "minMemoryMB": 3500,
        "backgroundCapable": False,
        "quality": {language: 3 for language in WHISPER_LANGUAGES},
        "qualityIsProvisional": True,
        "reference": [],
    }


