        # From SP-5, on a small synthetic set.
        "quality": {"en": 3, "ja": 3, "pt": 3, "es": 2},
        "qualityIsProvisional": True,
        "reference": [],
    }


def main():
    previous = {}
    if OUTPUT.exists():
        previous = {m["id"]: m.get("reference", []) for m in json.loads(OUTPUT.read_text())["models"]}
    models = [
        apple_speech(),
        apple_embedding(),
        community_one(),
        qwen_2b(),
        whisper(
            "whisper-small", "Whisper Small", "openai_whisper-small_216MB", "openai/whisper-small",
            1200, {"en": 3, "ja": 3, "pt": 3, "es": 3},
        ),
        whisper(
            "whisper-turbo", "Whisper Turbo", "openai_whisper-large-v3-v20240930_turbo_632MB",
            "openai/whisper-large-v3", 2500, {"en": 4, "ja": 4, "pt": 4, "es": 4},
        ),
    ]
    # Measured speeds come from real devices, and survive regenerating the file list.
    for model in models:
        model["reference"] = previous.get(model["id"], [])
    OUTPUT.write_text(json.dumps({"schema": 1, "models": models}, indent=1, sort_keys=True) + "\n")
    for model in models:
        size = sum(f["size"] for f in model["files"])
        print(f"{model['id']}: {len(model['files'])} files, {size // 1_000_000} MB")


if __name__ == "__main__":
    main()
